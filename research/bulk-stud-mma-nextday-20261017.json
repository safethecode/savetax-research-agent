      "original_core_purpose": "아스콘·투수콘·콘크리트 표면의 보행로·자전거도로·테마거리 등에 경관과 미끄럼 방지를 위한 3mm MMA 도막을 만든다. 원규격은 자동차 도로·생활체육시설·벽체를 적용 범위에서 제외한다.",
      "original_bom_per_m2": {
        "primer_mma_for_concrete_kg": "0.4",
        "resin_mma_kg": "3.5",
        "hardener_bpo_kg": "0.03",
        "aggregate_under_2_36mm_kg": "0.2",
        "note": "원품의 최소 소요량이다. 다른 제조사 수지의 소요량으로 사용하지 않았다."
      },
      "alternative_model": "KCC미끄럼방지재 주제 20kg 및 별도 BPO/규사/하도 후보; 두리하나 제브라페인트 20kg 후보",
      "adopted_benchmark_unit_price_krw": null,
      "expected_saving_krw": null,
      "comparison_assessment": {
        "core_purpose": {
          "status": "unverified",
          "basis": "MMA 노면 도장이라는 공통 용도는 있으나 각 후보의 보행로 3mm 도막 적용 방법과 도포량이 원품 범위에 맞는지는 닫히지 않았다."
        },
        "complete_product": {
          "status": "unverified",
          "basis": "필수 경화제와 콘크리트 하도, 골재·소요량·옵션 합계·세금 및 배송을 포함한 비교 단가가 미확정이다."
        }
      },
      "source_conflict": {
        "seller_claim": "HANDMAN의 본문은 3mm 두께에서 3.4~3.6kg/㎡라고 설명한다.",
        "manufacturer_pdf_source_url": "https://www.kccworld.co.kr/techdoc/c01/cvt/C01F202403200456513kor.pdf",
        "manufacturer_pdf_quote": "평활한 면에서 건조도막두께 2mm로 약 3.4 ~ 3.6kg/㎡",
        "manufacturer_pdf_publication_date": "2024-03-20",
        "manufacturer_pdf_pack": "주제 20kg, 경화제 하절0.2kg/동절0.4kg, 연화제15kg 별도 판매",
        "manufacturer_pdf_recommended_single_coat_mm": "1.5~2",
        "review": "공식 PDF의 2mm를 3mm로 바꾸지 않았다. 3mm 전용 구성과 가격이 닫히기 전에는 ㎡ 단가나 절감액을 채택하지 않는다."
      },
      "reason": "11번가 예다움 상품은 판매 중단이다. 다른 후보는 실제 포장 가격은 읽었지만 3mm 전용 도포량·필수 구성·VAT가 확정되지 않았다. 설치 노무의 미확인 자체를 일괄 차단 사유로 삼은 것이 아니다.",
      "follow_up": "새 SKU의 보행로 3mm 적용 도포량과 필요한 포장 구성이 직접 확인될 때 후속 검토한다."
    }
